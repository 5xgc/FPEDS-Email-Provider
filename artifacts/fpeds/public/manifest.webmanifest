{
  "id": "./",
  "name": "MoralTown Mail",
  "short_name": "MoralTown",
  "description": "A private, focused mailbox.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#090909",
  "theme_color": "#090909",
  "icons": [
    {
      "src": "./moraltown-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./moraltown-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}